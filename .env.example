# TMC DevOps MCP - 環境變數設定
# 複製此檔案為 .env 並填入您的設定值

# ============================================
# Azure DevOps 設定
# ============================================

# Azure DevOps 組織名稱 (必填)
ADO_ORG=your-org-name

# Personal Access Token (必填)
# 建立方式：Azure DevOps → User Settings → Personal Access Tokens
ADO_MCP_AUTH_TOKEN=your_pat_here

# ============================================
# LLM 設定 (AI Chatbot 功能)
# ============================================

# OpenAI API Key (必填)
OPENAI_API_KEY=your_openai_api_key_here

# API 端點 (選填)
# - OpenAI 官方：不需設定，預設 https://api.openai.com/v1
# - 公司內部 LLM：設定您的端點
# OPENAI_BASE_URL=https://your-company-llm.com/v1

# 模型名稱 (選填，預設: gpt-4o)
# OpenAI 官方選項: gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo
# 公司內部 LLM：填入您的模型名稱
# OPENAI_MODEL=gpt-4o

# ============================================
# API 伺服器設定
# ============================================

# API 伺服器 Port (選填，預設: 3001)
API_PORT=3001

# 日誌等級 (選填，預設: info)
# 選項: debug, info, warn, error
LOG_LEVEL=info
